          "name": "Weave Net Expose Network",
          "request": {
            "name": "Weave Net Expose Network",
            "description": {
              "content": "Assigns the given IP address/CIDR to the Weave bridge, exposing the Weave network to the host. This allows the host to communicate with containers on the Weave network.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "expose",
                ":cidr"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "cidr",
                  "description": "(Required) IP address and subnet in CIDR notation (e.g., 10.32.0.1/12)"
                }
              ]
            },
            "method": "POST",
            "auth": null
          },
          "response": [
