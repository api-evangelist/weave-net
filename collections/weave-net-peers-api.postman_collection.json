  "info": {
    "_postman_id": "7878be42-7373-49fd-b066-dd2e6bedcec9",
    "name": "Weave Net HTTP DNS Peers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Weave Net HTTP API provides programmatic control over the Weave Net container networking daemon. It is exposed locally on port 6784 and allows management of IPAM (IP address allocation), peer connections, DNS registration, network exposure, and status monitoring. This API is used internally by the weave CLI and can be used by tooling that manages container network configuration.",
      "type": "text/plain"
    }
